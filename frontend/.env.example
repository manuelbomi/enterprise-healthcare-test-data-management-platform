# Copy to .env.local for local development. Never commit a real .env file
# (see repository .gitignore) — these are placeholder/example values only.

# Base URL for the control-plane API. In local dev this is normally left
# unset and requests go through the Vite dev-server proxy configured in
# vite.config.ts instead. Setting this makes the browser call the
# control plane cross-origin directly (bypassing the proxy) -- the
# control plane must then have TDM_CONTROL_PLANE_CORS_ALLOWED_ORIGINS
# set to this frontend's origin (see services/control-plane/src/
# control_plane/config.py), or the browser will reject the response.
VITE_API_BASE_URL=http://localhost:8000

# Node-side (not shipped to the browser) override for the Vite dev
# server's /api proxy target (vite.config.ts), when the default
# http://localhost:8000 isn't where the control plane is running.
# CONTROL_PLANE_PROXY_TARGET=http://localhost:8000
