# Example environment values for local infrastructure. Copy to .env for
# use with `docker compose --env-file`. These are obvious local-only
# placeholder values, never real credentials — see SECURITY.md.

POSTGRES_USER=tdm
POSTGRES_PASSWORD=tdm_local_dev_only
POSTGRES_DB=tdm_metadata

MINIO_ROOT_USER=tdm_minio_admin
MINIO_ROOT_PASSWORD=tdm_local_dev_only
