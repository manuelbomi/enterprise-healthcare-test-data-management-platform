# Copy this file to `.env` in this directory for local development.
# `.env` (and `.env.*`) are excluded by the repository's root .gitignore --
# never commit a real value. See SECURITY.md.

# JWT signing key for control_plane.platform.auth's real, minimal
# identity-verification layer (Phase 18A -- resolves
# docs/problems/problems_final_review.md P0-1). Every RBAC-gated endpoint
# (dataset-version revoke, environment rollback, policy-version
# approve/reject, scheduler run-due) requires a bearer token issued by
# POST /api/v1/auth/login and signed with this key.
#
# Generate a throwaway LOCAL DEV/TEST-ONLY key with:
#   python -m control_plane.platform.auth --generate-dev-key
# then paste the printed value below (or export it directly in your
# shell instead of using this file at all). Never use the placeholder
# below for anything -- see services/control-plane/tests/conftest.py's
# fixed test-only key for how tests avoid depending on this file at all.
TDM_CONTROL_PLANE_JWT_SIGNING_KEY=REPLACE_WITH_A_LOCALLY_GENERATED_DEV_KEY_NEVER_COMMIT_A_REAL_VALUE

# Keyed HMAC signing key for the Phase 13 AuditEvidencePackage's
# bundle_checksum (Phase 18A -- resolves docs/problems/problems_final_review.md P1-7).
# A DIFFERENT secret from the JWT signing key above (different blast
# radius if leaked), never reused. See
# control_plane.platform.evidence_signing and
# docs/TAMPER_EVIDENCE_LIMITATIONS.md.
#
# Generate a throwaway LOCAL DEV/TEST-ONLY key with:
#   python -m control_plane.platform.evidence_signing --generate-dev-key
TDM_EVIDENCE_HMAC_KEY=REPLACE_WITH_A_LOCALLY_GENERATED_DEV_KEY_NEVER_COMMIT_A_REAL_VALUE
