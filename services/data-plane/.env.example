# Copy this file to `.env` in this directory for local development.
# `.env` (and `.env.*`) are excluded by the repository's root .gitignore --
# never commit a real value. See SECURITY.md and
# docs/adr/0006-deterministic-masking-strategy.md.

# HMAC secret key for Phase 3 deterministic masking
# (data_plane.masking.engine.MaskingEngine). Masking is keyed and
# deterministic on purpose: the same real value always masks to the same
# output within a scope (preserving referential integrity across tables
# and source systems), but only someone holding this key can compute that
# mapping -- see ADR-0006.
#
# Generate a throwaway LOCAL DEV/TEST-ONLY key with:
#   python -m data_plane.masking.cli --generate-dev-key
# then paste the printed value below (or export it directly in your
# shell instead of using this file at all). Never use the placeholder
# below for anything -- it is not a real key, and this repository's own
# tests assert that no real key is ever committed
# (services/data-plane/tests/masking/test_no_secrets_committed.py).
TDM_MASKING_HMAC_KEY=REPLACE_WITH_A_LOCALLY_GENERATED_DEV_KEY_NEVER_COMMIT_A_REAL_VALUE

# HMAC signing key for Phase 6 certification report tamper-evidence
# (data_plane.certification.signing) -- a DIFFERENT secret from the
# masking key above (different blast radius if leaked), never reused.
#
# Generate a throwaway LOCAL DEV/TEST-ONLY key with:
#   python -m data_plane.certification.cli --generate-dev-key
# then paste the printed value below (or export it directly instead).
# Never use the placeholder below for anything -- see
# services/data-plane/tests/certification/test_no_secrets_committed.py.
TDM_CERTIFICATION_HMAC_KEY=REPLACE_WITH_A_LOCALLY_GENERATED_DEV_KEY_NEVER_COMMIT_A_REAL_VALUE
